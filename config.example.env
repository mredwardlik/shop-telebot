# Copy this file to config.env and fill it in. config.env is not committed.
# Every key can also be set as an environment variable.

# Token of the bot from @BotFather, like 123456789:AAH...xyz
TOKEN=

# Telegram ids of admins who receive orders, separated by commas.
# Your id can be found with @userinfobot. Each admin must press Start in the bot once.
ADMINS=123456789

# Folders with views and products, relative to this file
VIEWS_DIR=views
PRODUCTS_DIR=views/products

# Optional: button texts and the number of product buttons in a row
# BUY_BUTTON=🛒 Купить
# ORDERED_BUTTON=✅ Заявка отправлена
# ROW_WIDTH=2
